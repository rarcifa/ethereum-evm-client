{
  "name": "@rarcifa/ethereum-evm-client",
  "version": "1.0.0",
  "description": "A TypeScript client for reading ERC20, ERC721 and ERC1155 token data from Ethereum and other EVM compatible chains over JSON-RPC.",
  "keywords": [
    "blockchain",
    "ethereum",
    "evm",
    "erc20",
    "erc721",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/rarcifa/ethereum-evm-client#readme",
  "bugs": {
    "url": "https://github.com/rarcifa/ethereum-evm-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rarcifa/ethereum-evm-client.git"
  },
  "license": "MIT",
  "author": "Ricardo Arcifa rarcifa@gmail.com",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "babel-jest": "30.5.2",
    "jest": "30.5.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  }
}
